{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/typescript/tsbuildinfo-backend",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@backend/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.mts"],
  "exclude": ["node_modules", "../dist", "**/*.test.ts", "scripts/**"]
}
